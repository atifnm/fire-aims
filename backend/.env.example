# Copy to .env and adjust as needed.

ENV=development

# SQLite (default, zero-config, good for local dev/demo):
DATABASE_URL=sqlite:///./fireaims.db

# PostgreSQL (recommended for production / docker-compose):
# DATABASE_URL=postgresql+psycopg2://fireaims:fireaims@db:5432/fireaims

SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
