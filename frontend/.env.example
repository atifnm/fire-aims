# Copy to .env and adjust as needed. Only needed when the frontend and backend are deployed
# as separate services with separate URLs (e.g. Railway). Leave unset for local dev — Vite's
# dev server proxies /api and /static to the backend automatically (see vite.config.js).

# Full public URL of the backend, no trailing slash, no /api suffix:
# VITE_API_URL=https://fire-aims-backend-production.up.railway.app
